{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2023"],
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "rootDir": ".",
        "types": ["node"],
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "entrypoints/**/*.ts",
        "entrypoints/**/*.tsx",
        "../../packages/types/src/**/*.d.ts",
    ],
    "exclude": ["node_modules", "dist"],
}
