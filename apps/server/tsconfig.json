{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2023"],
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "rootDir": "../..",
        "types": ["node"],
    },
    "include": [
        "./src/**/*.ts",
        "./src/**/*.tsx",
        "../../apps/web/src/**/*.ts",
        "../../apps/web/src/**/*.tsx",
        "../../packages/types/src/**/*.d.ts",
        "worker-configuration.d.ts",
    ],
    "exclude": ["node_modules", "dist"],
}
