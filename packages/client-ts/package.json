{
    "name": "unbound-auth",
    "version": "0.1.0",
    "description": "Javascript client to simplify using Unbound Auth",
    "type": "module",
    "scripts": {
        "lint": "oxlint",
        "build": "pnpm lint && tsdown",
        "build:watch": "tsdown --watch"
    },
    "keywords": [
        "unbound",
        "auth"
    ],
    "author": "Realzzy",
    "packageManager": "pnpm@10.14.0",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./adapters": {
            "types": "./dist/adapters/index.d.ts",
            "import": "./dist/adapters/index.js",
            "require": "./dist/adapters/index.cjs"
        }
    },
    "publishConfig": {
        "provenance": true,
        "access": "public"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.0",
        "oxlint": "^1.71.0",
        "tsdown": "^0.22.3",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "jose": "^6.2.3"
    }
}
